---
import { social } from "../data/social";
---

<header class="hero">
	<h1>Hey, I'm Ritvik.</h1>
	<div class="hero-photo" aria-label="Photo of Ritvik">
		<img src="/me.jpg" alt="Ritvik" width="160" height="160" loading="eager" />
	</div>
	<ul class="hero-social">
		<li>
			<a href={social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.26 2.37 4.26 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"
					></path>
				</svg>
			</a>
		</li>
		<li>
			<a href={social.email} class="email-link" aria-label={`Email ${social.emailLabel}`}>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"
					></path>
				</svg>
				<span class="email-note" role="tooltip" aria-hidden="true">{social.emailLabel}</span>
			</a>
		</li>
		<li>
			<a href={social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						d="M12 2C6.48 2 2 6.58 2 12.26c0 4.52 2.87 8.32 6.84 9.67.5.1.68-.22.68-.48 0-.24-.01-.87-.01-1.7-2.78.62-3.37-1.36-3.37-1.36-.45-1.18-1.12-1.5-1.12-1.5-.92-.64.07-.63.07-.63 1.02.07 1.56 1.07 1.56 1.07.9 1.57 2.36 1.12 2.94.85.09-.67.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.1 0-1.13.39-2.05 1.03-2.77-.1-.26-.45-1.32.1-2.74 0 0 .84-.27 2.75 1.02A9.3 9.3 0 0 1 12 6.84c.85.004 1.71.12 2.51.35 1.91-1.29 2.75-1.02 2.75-1.02.55 1.42.2 2.48.1 2.74.64.72 1.03 1.64 1.03 2.77 0 3.97-2.35 4.84-4.58 5.1.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.8 0 .27.18.59.69.48A10.14 10.14 0 0 0 22 12.26C22 6.58 17.52 2 12 2z"
					></path>
				</svg>
			</a>
		</li>
	</ul>
	<p class="hero-tagline">Data science student. This is my journey.</p>
	<button type="button" class="hero-scroll scroll-indicator" data-hero-scroll aria-label="Scroll to the journey">
		<span class="scroll-indicator__track" aria-hidden="true">
			<span class="scroll-indicator__dot"></span>
		</span>
	</button>
</header>

<script>
	const button = document.querySelector<HTMLButtonElement>("[data-hero-scroll]");
	const journey = document.querySelector<HTMLElement>("[data-journey]");

	button?.addEventListener("click", () => {
		if (!journey) return;
		const event = new CustomEvent("journey:enter", { cancelable: true });
		journey.dispatchEvent(event);
		if (!event.defaultPrevented) journey.scrollIntoView({ block: "start" });
	});

	const hideOnScroll = () => {
		if (!button) return;
		const show = window.scrollY < window.innerHeight * 0.35;
		button.classList.toggle("is-hidden", !show);
	};
	hideOnScroll();
	window.addEventListener("scroll", hideOnScroll, { passive: true });
</script>
